# Amaura JARVIS 5.4 — production template
# Generate every secret independently:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
AMAURA_FOUNDER_NAME=Akshat
AMAURA_FOUNDER_ID=founder
AMAURA_DATA_DIR=./.amaura-data
JARVIS_DATA_DIR=./.jarvis-data

# Authority keys must be distinct. Reviewer entries use reviewer_id:key.
AMAURA_OPERATOR_KEY=replace-with-independent-random-value
AMAURA_APPROVAL_KEY=replace-with-independent-random-value
AMAURA_REVIEWER_KEYS=qa-reviewer:replace-with-independent-random-value
AMAURA_REVIEW_ATTESTATION_KEY=replace-with-independent-random-value
AMAURA_PROVIDER_RECEIPT_KEY=replace-with-independent-random-value
AMAURA_AUDIT_HMAC_KEY=replace-with-independent-random-value
AMAURA_EVIDENCE_HMAC_KEY=replace-with-independent-random-value
AMAURA_EVALUATION_PACK_HMAC_KEY=replace-with-independent-random-value
JARVIS_API_KEY=replace-with-independent-random-value

# Local-only API by default.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_RELOAD=0
JARVIS_REQUIRE_LOCAL_AUTH=1
JARVIS_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
JARVIS_WS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─── OmniRoute — primary cognition gateway (v5.4.1) ────────────────────────
# Run Setup_Amaura_OmniRoute.command to configure securely via guided prompts.
# AMAURA_MODEL_PROVIDER=omniroute         # set this to activate OmniRoute
# AMAURA_OMNIROUTE_BASE_URL=             # e.g. https://api.omniroute.ai/v1
# AMAURA_OMNIROUTE_API_KEY=              # your OmniRoute API key  (never commit)
# AMAURA_OMNIROUTE_MODEL=               # e.g. claude-3-5-sonnet-20241022
# AMAURA_OMNIROUTE_CHAT_MODEL=groq/llama-3.3-70b-versatile  # fast remote chat; no local RAM use
# AMAURA_OMNIROUTE_REVIEW_MODEL=auto/best-reasoning # independent reviewer route
# AMAURA_OMNIROUTE_FALLBACK_MODEL=      # optional fallback model id
# AMAURA_OMNIROUTE_WORKER_TIMEOUT_SECONDS=180
# AMAURA_OMNIROUTE_MAX_RETRIES=0        # interactive default: no repeated stalls
# AMAURA_OMNIROUTE_TIMEOUT_SECONDS=8    # per-attempt interactive timeout
AMAURA_JARVIS_INTERACTIVE_DEADLINE_SECONDS=12
AMAURA_JARVIS_INTERACTIVE_MAX_RETRIES=0
AMAURA_JARVIS_INTERACTIVE_LEGACY_FALLBACK=0
AMAURA_PROVIDER_CIRCUIT_FAILURES=2
AMAURA_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
# ── Supported sub-providers (examples, OmniRoute handles routing internally) ─
# OMNIROUTE_PROVIDERS=openai,anthropic,google,mistral,cohere
# ─── End OmniRoute block ────────────────────────────────────────────────────

# Model routes. Local is the production-safe default; balanced/cloud are opt-in.
AMAURA_MODEL_MODE=local
AMAURA_LOCAL_MODEL=nova:3b
AMAURA_LOCAL_REVIEW_MODEL=qwen2.5-coder:3b
AMAURA_CLOUD_WORKER_MODEL=
AMAURA_REVIEW_MODE=auto
AMAURA_CLOUD_REVIEW_MODEL=
NVIDIA_API_KEY=
NVIDIA_REVIEW_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
AMAURA_DISABLE_CLOUD=1

# A signed, private 20+ case pack is mandatory for a production verdict.
AMAURA_REQUIRE_PRIVATE_EVAL_PACK=1
AMAURA_MODEL_EVALUATION_PACK=/absolute/path/outside/repository/amaura-private-eval.json

# Governed runtime limits.
AMAURA_RESOURCE_PROFILE=macbook-8gb
AMAURA_LEASE_SECONDS=900
AMAURA_MAX_ATTEMPTS=3
AMAURA_OUTBOX_MAX_ATTEMPTS=3
AMAURA_OUTBOX_LEASE_SECONDS=120
AMAURA_AUTOPILOT_POLL_SECONDS=30
AMAURA_AUTOPILOT_MAX_WORK_UNITS=4
AMAURA_AUTOPILOT_MAX_NEW_PROGRAMMES=3
AMAURA_AUTOPILOT_MAX_SIGNALS=3
AMAURA_AUTOPILOT_FAILURE_BACKOFF_BASE_SECONDS=5
AMAURA_AUTOPILOT_FAILURE_BACKOFF_MAX_SECONDS=300
AMAURA_AUTOPILOT_CRASH_THRESHOLD=5

# Unified desktop/server Company OS + Amaura Ventures runtime. A cross-process
# leader lock prevents a desktop process and launch daemon from mutating the
# same company cycle simultaneously.
AMAURA_COMPANY_AUTOPILOT_RUNTIME=0
AMAURA_COMPANY_AUTOPILOT_POLL_SECONDS=600
AMAURA_COMPANY_AUTOPILOT_WORK_UNITS=1
AMAURA_COMPANY_AUTOPILOT_NEW_PROGRAMMES=2
AMAURA_COMPANY_AUTOPILOT_SIGNALS=2
AMAURA_VENTURE_PROPOSALS_PER_CYCLE=4
AMAURA_VENTURE_ACTION_MAX_RETRIES=2
AMAURA_SIGNAL_DAILY_BUDGET_CENTS=5000
AMAURA_DEPARTMENT_FAILURE_THRESHOLD=3
AMAURA_MONTHLY_COST_ALERT_CENTS=0

# Evidence, backups and sandbox.
AMAURA_EVIDENCE_DIR=./.amaura-data/evidence
# Use a separate encrypted/cloud-synced volume or trust account, not AMAURA_DATA_DIR.
AMAURA_AUDIT_CHECKPOINT_PATH=/absolute/path/to/separate-trust-store/audit-head.json
AMAURA_BACKUP_DIR=/absolute/path/to/separate-backup-volume/amaura
AMAURA_AUTOMATIC_BACKUPS=1
AMAURA_BACKUP_RETENTION_DAYS=14
AMAURA_SANDBOX_MODE=docker
AMAURA_SANDBOX_IMAGE=amaura-sandbox:3.6.0
# After building: docker image inspect amaura-sandbox:3.6.0 --format '{{.Id}}'
AMAURA_SANDBOX_IMAGE_DIGEST=
AMAURA_SANDBOX_MEMORY=1g
AMAURA_SANDBOX_CPUS=1.5
AMAURA_WORKTREE_ROOT=/tmp/amaura-worktrees
AMAURA_GIT_AUTHOR_NAME=Amaura Agent
AMAURA_GIT_AUTHOR_EMAIL=amaura@local.invalid
AMAURA_POST_MERGE_COMMAND=python -m pytest -q
AMAURA_POST_MERGE_TIMEOUT=600

# Fail-closed launch controls.
AMAURA_STRICT_EVIDENCE=1
AMAURA_STRICT_EVIDENCE_SIGNATURES=1
AMAURA_STRICT_AUDIT_SIGNATURES=1
AMAURA_STRICT_AUDIT_CHECKPOINT=1
AMAURA_STRICT_REVIEW=1
AMAURA_STRICT_GIT=1
AMAURA_ENABLE_EXPERIMENTAL_LANGGRAPH=0

# Conversational tools mode
JARVIS_LEGACY_TOOL_MODE=disabled
AMAURA_ENABLE_BREAK_GLASS_LEGACY_TOOLS=0
JARVIS_ENABLE_LEGACY_DIRECT_TOOLS=0

# Gmail official API. Prefer refresh credentials for long-running operation.
AMAURA_ENABLE_GMAIL=0
AMAURA_GMAIL_ACCESS_TOKEN=
AMAURA_GMAIL_CLIENT_ID=
AMAURA_GMAIL_CLIENT_SECRET=
AMAURA_GMAIL_REFRESH_TOKEN=

# iMessage (macOS only). Normal sends still pass through approval + outbox.
AMAURA_ENABLE_IMESSAGE=0
AMAURA_IMESSAGE_PROVIDER=local

# n8n bridge. Webhooks must echo exact identifiers/digests and sign receipts.
AMAURA_ENABLE_N8N=0
AMAURA_ALLOW_LOCAL_N8N=0
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_EMAIL=amaura-email-send
N8N_WEBHOOK_CRM=amaura-crm-sync
N8N_WEBHOOK_IMESSAGE=amaura-imessage-send

# Publishing remains approval-gated and disabled until configured.
AMAURA_ENABLE_PUBLICATION=0
AMAURA_PUBLICATION_ENDPOINT=
AMAURA_PUBLICATION_ACCESS_TOKEN=
AMAURA_ENABLE_PUBLIC_PUBLISH=0
AMAURA_PUBLIC_PUBLISH_ENDPOINT=
AMAURA_PUBLIC_PUBLISH_ACCESS_TOKEN=

# Notifications and optional infrastructure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
QDRANT_URL=
TWENTY_BASE_URL=
TWENTY_API_KEY=
POSTHOG_HOST=
POSTHOG_API_KEY=
AMAURA_HANDOFF_DIR=./.amaura-data/handoffs
AMAURA_ANTIGRAVITY_ENABLED=1
AMAURA_GOOGLE_FLOW_ENABLED=0
GEMINI_API_KEY=
AMAURA_ALLOW_PAID_MEDIA=0


# Free-first v3.6 integrations. All external actions remain approval-gated.
AMAURA_BROWSER_HANDOFF_OPEN=0
AMAURA_DRIVE_MAX_UPLOAD_BYTES=10485760
AMAURA_GOOGLE_ACCESS_TOKEN=
AMAURA_GOOGLE_CLIENT_ID=
AMAURA_GOOGLE_CLIENT_SECRET=
AMAURA_GOOGLE_REFRESH_TOKEN=
AMAURA_GITHUB_TOKEN=
AMAURA_LINKEDIN_ACCESS_TOKEN=
AMAURA_LINKEDIN_AUTHOR_URN=
AMAURA_LINKEDIN_VERSION=
AMAURA_META_ACCESS_TOKEN=
AMAURA_META_GRAPH_VERSION=
AMAURA_META_APP_SECRET=
AMAURA_META_VERIFY_TOKEN=
AMAURA_FACEBOOK_PAGE_ID=
AMAURA_INSTAGRAM_ACCOUNT_ID=
AMAURA_POSTHOG_HOST=https://us.i.posthog.com
AMAURA_POSTHOG_PROJECT_KEY=
AMAURA_UPI_ID=
AMAURA_UPI_PAYEE_NAME=Amaura Labs
AMAURA_NEXUS_COMMAND=nexus
AMAURA_NEXUS_ARGUMENTS=run --request-file {request} --result-file {result}

# Amaura Ventures constraints.
AMAURA_VENTURE_MIN_SCORE=70
AMAURA_VENTURE_MIN_INDEPENDENT_SOURCES=2
AMAURA_VENTURE_MAX_ACTIVE_SPRINTS=1
AMAURA_VENTURE_MAX_SPRINT_BUDGET_CENTS=5000
AMAURA_VENTURE_FOUNDER_REVIEW_MINUTES=20
AMAURA_VENTURE_FOUNDER_WEEKLY_MINUTES=60
AMAURA_VENTURE_MAX_FOUNDER_MINUTES_WEEKLY=180
AMAURA_VENTURE_MAX_LIVE_STREAMS=4

# OSS capability runtime (lazy/on-demand; tuned for M3 8 GB by default).
# v3.6.1 8 GB Mac memory policy. No RAM is pre-reserved; these are admission/kill targets.
AMAURA_RAM_NORMAL_TARGET_MB=768
AMAURA_RAM_BURST_LIMIT_MB=1536
AMAURA_RAM_ABSOLUTE_LIMIT_MB=2048
AMAURA_RAM_PRESSURE_LIMIT_MB=768
AMAURA_ANTIGRAVITY_RESERVATION_MB=768
AMAURA_ANTIGRAVITY_MAX_RSS_MB=1536
AMAURA_SWAP_GROWTH_ABORT_MB=192
AMAURA_RESOURCE_LEDGER_PATH=
# Legacy v3.6.0 knob is ignored by the new scheduler.
AMAURA_LOCAL_RAM_BUDGET_MB=
SEARXNG_URL=
AMAURA_QDRANT_PATH=.amaura-qdrant
QDRANT_API_KEY=
COMFYUI_URL=
COMFYUI_API_TOKEN=
AMAURA_MCP_REGISTRY_PATH=
AMAURA_MCP_TOOL_CALLS_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
AMAURA_BROWSER_USE_AGENT_ENABLED=0
AMAURA_BROWSER_USE_MODEL=
AMAURA_WHISPER_MODEL=small
AMAURA_REMOTION_VERSION=4.0.477
AMAURA_STRICT_MEDIA_SANDBOX=1
# OSS capability runtime
AMAURA_CAPABILITY_HEAVY_LOCK=
AMAURA_MEDIA_DOWNLOADS_ENABLED=0
AMAURA_ALLOW_LOCAL_COMFYUI=0


# === Amaura JARVIS general intelligence layer ===
# Optional: let a model create bounded dynamic plans. Deterministic planning stays available offline.
AMAURA_JARVIS_LLM_PLANNER=auto
AMAURA_JARVIS_REQUIRE_LLM_PLANNER=0
AMAURA_JARVIS_PLANNER_MODEL=
AMAURA_JARVIS_PLANNER_ALLOW_FALLBACKS=1

# === Noryx engineering worker ===
# Disabled by default while Noryx is under development.
AMAURA_ENABLE_EXPERIMENTAL_NORYX=0
# Preferred v4 names. Legacy AMAURA_NEXUS_* remains supported for compatibility.
AMAURA_NORYX_COMMAND=noryx
AMAURA_NORYX_ARGUMENTS=run --request-file {request} --result-file {result}
# Optional comma-separated extra environment names Noryx is allowed to inherit.
AMAURA_NORYX_ENV_ALLOWLIST=

# JARVIS cognition: auto uses configured model credentials, while deterministic fallbacks remain available.
AMAURA_JARVIS_INTENT_MODEL=auto
AMAURA_JARVIS_PROACTIVE_INTERVAL_SECONDS=600
AMAURA_JARVIS_PROACTIVE_INVESTIGATIONS=0
AMAURA_JARVIS_PROACTIVE=0

# === JARVIS v5 persistent executive runtime ===
# Durable mission execution continues independently of the initiating chat request.
AMAURA_JARVIS_MISSION_RUNNER=1
AMAURA_JARVIS_MISSION_POLL_SECONDS=3
AMAURA_JARVIS_MISSION_MAX_GOALS=1
# Keep synchronous submit disabled except bounded debugging/compatibility tests.
AMAURA_JARVIS_SYNC_SUBMIT=0

# Independent verification is mandatory for Noryx success in v5.
AMAURA_NORYX_INDEPENDENT_VERIFY=1
AMAURA_NORYX_VERIFY_TIMEOUT_SECONDS=300

# One exact provider gateway powers planner/intent/reference/memory cognition.
# Values: auto, openrouter, openai, anthropic, nvidia, groq, ollama
AMAURA_JARVIS_PROVIDER=auto
AMAURA_JARVIS_PROVIDER_ORDER=openrouter,openai,anthropic,nvidia,groq,ollama
AMAURA_JARVIS_MODEL=
AMAURA_JARVIS_REFERENCE_MODEL=
AMAURA_JARVIS_MEMORY_MODEL=
AMAURA_JARVIS_MEMORY_CONSOLIDATION=0
# Provider-specific model names are required for OpenRouter/OpenAI/Anthropic.
AMAURA_OPENROUTER_MODEL=
AMAURA_OPENAI_MODEL=
AMAURA_ANTHROPIC_MODEL=
AMAURA_NVIDIA_MODEL=
AMAURA_GROQ_MODEL=
AMAURA_OLLAMA_MODEL=

# --- JARVIS engineering backend (v5.1) ---
# Antigravity CLI is the default production coding worker. Noryx remains explicit/experimental.
AMAURA_ANTIGRAVITY_COMMAND=agy
AMAURA_ANTIGRAVITY_MODE=cli
AMAURA_ANTIGRAVITY_REQUIRE_AUTONOMY_SETTINGS=1
# Optional model override supported by current agy --model. Leave empty to use Antigravity's selected model.
AMAURA_ANTIGRAVITY_MODEL=
AMAURA_ANTIGRAVITY_PROJECT_ID=default-cli-project
# If Antigravity has project-scoped config and auto-discovery cannot resolve it, set the exact JSON path:
AMAURA_ANTIGRAVITY_PROJECT_SETTINGS=
AMAURA_ANTIGRAVITY_ALLOW_UNRESOLVED_PROJECT_SETTINGS=0
AMAURA_ANTIGRAVITY_ALLOW_WORKSPACE_EXECUTABLE_CUSTOMIZATIONS=0
AMAURA_ANTIGRAVITY_ALLOW_GLOBAL_EXECUTABLE_CUSTOMIZATIONS=0
AMAURA_ANTIGRAVITY_REQUIRE_MODEL_PROVENANCE=1
AMAURA_ANTIGRAVITY_RESERVATION_MB=1800
# Independent verification is fail-closed: macOS uses sandbox-exec automatically; other hosts require Docker.
AMAURA_VERIFIER_MODE=auto
# Never set this to 1 outside isolated development tests.
AMAURA_ALLOW_HOST_VERIFICATION=0
# Executive local fallback model.
AMAURA_JARVIS_OLLAMA_PROBE=0
AMAURA_JARVIS_ALLOW_OLLAMA=0
